<Keyboard>
  <Name>OptiKey-HorizontalBoard</Name>
  <Width>100%</Width>
  <Height>46%</Height>
  <SymbolMargin>12</SymbolMargin>
  <DockSize>Full</DockSize>
  <Position>Bottom</Position>
  <HorizontalOffset>0</HorizontalOffset>
  <VerticalOffset>0</VerticalOffset>
  <WindowState>Floating</WindowState>
  <Grid>
    <Rows>4</Rows>
    <Cols>14</Cols>
  </Grid>
  <HideFromKeyboardMenu>true</HideFromKeyboardMenu>
  <PersistNewState>false</PersistNewState>
  <KeyGroup Name="Alphabet" />
  <KeyGroup Name="Numbers" />
  <KeyGroup Name="Punctuations" />
  <KeyGroup Name="Modifiers" />
  <KeyGroup Name="Functions" />
  <KeyGroup Name="Predictions" />
  <KeyGroup Name="Conversations" />
  <KeyGroup Name="Others" />
  <KeyGroup Name="Navigation" />
  <KeyGroup Name="Editing" />
  <KeyGroup Name="Mouse" />
  <KeyGroup Name="Gamepad" />
  <Content>
    <!-- Row 0 -->
    <DynamicKey>
      <Symbol>UpArrowKeyIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="false">keyboard-alphabet-14x4-top</ChangeKeyboard>
      <KeyGroup>Mirror</KeyGroup>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>PhysicalKeysIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="false">keyboard-function-14x4-bottom</ChangeKeyboard>
      <KeyGroup>Pagination</KeyGroup>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>EraserIcon</Symbol>
      <Action>ClearScratchpad</Action>
      <KeyGroup>Exit</KeyGroup>
      <KeyGroup>Editing</KeyGroup>
    </DynamicKey>
    <SuggestionRow Width="8" CompletionTimes="1000,1000,200">
      <KeyGroup>Suggestion</KeyGroup>
      <KeyGroup>Predictions</KeyGroup>
    </SuggestionRow>
    <DynamicKey>
      <Symbol>LayersIcon</Symbol>
      <Action>CycleKeyMode</Action>
      <KeyGroup>Exit</KeyGroup>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>NumericAndSymbolsIcon</Symbol>
      <ChangeKeyboard BackReturnsHere="false">keyboard-numeric-14x4-bottom</ChangeKeyboard>
      <KeyGroup>Pagination</KeyGroup>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>NoIcon</Symbol>
      <Action>BackFromKeyboard</Action>
      <KeyGroup>Exit</KeyGroup>
      <KeyGroup>Navigation</KeyGroup>
    </DynamicKey>
    <!-- Row 1 -->
    <DynamicKey>
      <Symbol>ShiftKeyIcon</Symbol>
      <Action>LeftShift</Action>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Modifiers</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>TabKeyIcon</Symbol>
      <Text>&#9;</Text>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>Q</ShiftDownLabel>
      <Label>q</Label>
      <PhysicalKey>Q</PhysicalKey>
      <Text>q</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>W</ShiftDownLabel>
      <Label>w</Label>
      <PhysicalKey>W</PhysicalKey>
      <Text>w</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>E</ShiftDownLabel>
      <Label>e</Label>
      <PhysicalKey>E</PhysicalKey>
      <Text>e</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>R</ShiftDownLabel>
      <Label>r</Label>
      <PhysicalKey>R</PhysicalKey>
      <Text>r</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>T</ShiftDownLabel>
      <Label>t</Label>
      <PhysicalKey>T</PhysicalKey>
      <Text>t</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>Y</ShiftDownLabel>
      <Label>y</Label>
      <PhysicalKey>Y</PhysicalKey>
      <Text>y</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>U</ShiftDownLabel>
      <Label>u</Label>
      <PhysicalKey>U</PhysicalKey>
      <Text>u</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>I</ShiftDownLabel>
      <Label>i</Label>
      <PhysicalKey>I</PhysicalKey>
      <Text>i</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>O</ShiftDownLabel>
      <Label>o</Label>
      <PhysicalKey>O</PhysicalKey>
      <Text>o</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>P</ShiftDownLabel>
      <Label>p</Label>
      <PhysicalKey>P</PhysicalKey>
      <Text>p</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>"</ShiftDownLabel>
      <Label>'</Label>
      <Text>'</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>BackspaceKeyIcon</Symbol>
      <Action>BackOne</Action>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Editing</KeyGroup>
    </DynamicKey>
    <!-- Row 2 -->
    <DynamicKey>
      <Symbol>WinKeyIcon</Symbol>
      <Action>LeftWin</Action>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Modifiers</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>:</ShiftDownLabel>
      <Label>;</Label>
      <Text>;</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>A</ShiftDownLabel>
      <Label>a</Label>
      <PhysicalKey>A</PhysicalKey>
      <Text>a</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>S</ShiftDownLabel>
      <Label>s</Label>
      <PhysicalKey>S</PhysicalKey>
      <Text>s</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>D</ShiftDownLabel>
      <Label>d</Label>
      <PhysicalKey>D</PhysicalKey>
      <Text>d</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>F</ShiftDownLabel>
      <Label>f</Label>
      <PhysicalKey>F</PhysicalKey>
      <Text>f</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>G</ShiftDownLabel>
      <Label>g</Label>
      <PhysicalKey>G</PhysicalKey>
      <Text>g</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>H</ShiftDownLabel>
      <Label>h</Label>
      <PhysicalKey>H</PhysicalKey>
      <Text>h</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>J</ShiftDownLabel>
      <Label>j</Label>
      <PhysicalKey>J</PhysicalKey>
      <Text>j</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>K</ShiftDownLabel>
      <Label>k</Label>
      <PhysicalKey>K</PhysicalKey>
      <Text>k</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>L</ShiftDownLabel>
      <Label>l</Label>
      <PhysicalKey>L</PhysicalKey>
      <Text>l</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>{</ShiftDownLabel>
      <Label>[</Label>
      <Text>[</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>}</ShiftDownLabel>
      <Label>]</Label>
      <Text>]</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>EnterIcon</Symbol>
      <Text>&#13;</Text>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <!-- Row 3 -->
    <DynamicKey>
      <Symbol>CtrlKeyIcon</Symbol>
      <Action>LeftCtrl</Action>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Modifiers</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Symbol>AltKeyIcon</Symbol>
      <Action>LeftAlt</Action>
      <KeyGroup>Modifier</KeyGroup>
      <KeyGroup>Modifiers</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <Label>␣</Label>
      <Text>&#32;</Text>
      <KeyGroup>Others</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>Z</ShiftDownLabel>
      <Label>z</Label>
      <PhysicalKey>Z</PhysicalKey>
      <Text>z</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>X</ShiftDownLabel>
      <Label>x</Label>
      <PhysicalKey>X</PhysicalKey>
      <Text>x</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>C</ShiftDownLabel>
      <Label>c</Label>
      <PhysicalKey>C</PhysicalKey>
      <Text>c</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>V</ShiftDownLabel>
      <Label>v</Label>
      <PhysicalKey>V</PhysicalKey>
      <Text>v</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>B</ShiftDownLabel>
      <Label>b</Label>
      <PhysicalKey>B</PhysicalKey>
      <Text>b</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>N</ShiftDownLabel>
      <Label>n</Label>
      <PhysicalKey>N</PhysicalKey>
      <Text>n</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>M</ShiftDownLabel>
      <Label>m</Label>
      <PhysicalKey>M</PhysicalKey>
      <Text>m</Text>
      <KeyGroup>Alphabet</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>></ShiftDownLabel>
      <Label>.</Label>
      <Text>.</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>&lt;</ShiftDownLabel>
      <Label>,</Label>
      <Text>,</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>_</ShiftDownLabel>
      <Label>-</Label>
      <Text>-</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
    <DynamicKey>
      <ShiftDownLabel>?</ShiftDownLabel>
      <Label>/</Label>
      <Text>/</Text>
      <KeyGroup>Punctuation</KeyGroup>
      <KeyGroup>Punctuations</KeyGroup>
    </DynamicKey>
  </Content>
</Keyboard>